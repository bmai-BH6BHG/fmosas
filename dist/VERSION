# FMO 分系统 发布版本信息（构建时由 build_release.sh 读取）
# VERSION          : 发布版本号，会写入 install.sh 与打包文件名
# RELEASE_BASE_URL : 分发根地址，install.sh / upgrade.sh 从这里下载包与校验文件
#
# ★★ 分发策略（v1.8.49 起，真实故障驱动，务必遵守）★★
#   GitHub 只作为「源码托管 + CI 构建」源头，**不作为节点分发源**：
#   国内分系统实测无法访问 github.com（curl 超时 HTTP=000，DNS 污染/阻断）。
#
#   曾经的故障链：
#     1) 运维指令下发成功，节点去 GitHub 取站点 VERSION
#     2) 取不到 → 目标版本退化成 DEFAULT_VERSION（1.0.0）
#     3) 1.0.0 < 当前版本 → 判定「这是降级，不是升级」→ 拒绝执行
#     4) 表面现象：总系统显示「已触发」，节点版本却纹丝不动
#
#   现在的流程：
#     1) 打 tag → GitHub Actions 构建 Release 资产
#     2) mirror_release.py 下载资产 → 上传到云分发站 /opt/fmo-dist
#     3) 节点从云分发站升级（运维指令里带 base_url 更稳）
#
#   云分发站：http://175.24.227.38:8080
#             服务 systemd fmo-dist（python3 -m http.server 8080）
#             目录 /opt/fmo-dist
VERSION=1.8.51
RELEASE_BASE_URL=http://175.24.227.38:8080

# 部署后 install.sh 的可选环境变量（默认全自动，无需任何参数）：
#   FMO_BASE_URL  覆盖下载根地址（仅当分发地址变更时使用）
#   FMO_DIR       覆盖安装目录（默认 /opt/fmo-subsystem 或可写回退目录）
#   FMO_PORT      覆盖公网 API 端口（默认 35928，管理端口自动为端口+1）
#   FMO_DOMAIN    覆盖对外域名（默认取本机 IP，用于数据库命名与上报）
#   FMO_MASTER    覆盖总系统地址（默认沿用 config.json 内的 master_url）
#   FMO_NO_SERVICE=1  只解压部署，不注册开机自启服务
